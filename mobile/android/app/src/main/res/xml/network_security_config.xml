<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ bloque le HTTP non chiffré par défaut.
  Exception limitée au backend local vu depuis l'émulateur Android (10.0.2.2),
  pour le développement. Une fois l'API déployée en HTTPS :
    1. mettre l'URL https:// dans lib/core/config.dart
    2. supprimer le bloc domain-config ci-dessous
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
